<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd ">
    <http:listener-config name="proyectointegrador-httpListenerConfig">
        <http:listener-connection host="0.0.0.0" port="8080" />
    </http:listener-config>
    <apikit:config name="proyectointegrador-config" api="resource::e4469c3e-2945-4129-8752-e74791f8156c:proyectointegrador:1.0.0:oas:zip:proyectointegrador.yaml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />
    <flow name="proyectointegrador-main">
        <http:listener config-ref="proyectointegrador-httpListenerConfig" path="/api/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:router config-ref="proyectointegrador-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:BAD_REQUEST">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Bad request"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">400</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:METHOD_NOT_ALLOWED">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Method not allowed"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">405</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_ACCEPTABLE">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not acceptable"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">406</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:UNSUPPORTED_MEDIA_TYPE">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Unsupported media type"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">415</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_IMPLEMENTED">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not Implemented"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">501</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="proyectointegrador-console">
        <http:listener config-ref="proyectointegrador-httpListenerConfig" path="/console/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="proyectointegrador-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="Transform Message">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="patch:\ActualizarCorreo\(id):application\json:proyectointegrador-config">
        <ee:transform doc:name="Transform Message">
            <ee:variables>
                <ee:set-variable variableName="id">attributes.uriParams.'id'</ee:set-variable>
            </ee:variables>
        </ee:transform>
        <logger level="INFO" message="ID Recibido: #[vars.id]" />
		<ee:transform doc:name="Transform Message" doc:id="c4f4ebe6-df5c-46b4-8f67-4b1033fb2fd6" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/java
---
{
	"correo": payload.correo
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="Logger" doc:id="9411a556-416f-4884-9366-49e0a42db574" message="Correo Recibido: #[payload.correo]" />
		<http:request method="PATCH" doc:name="Request" doc:id="b8f3cf0c-f4c7-433d-8e89-8fdf382af50a" url='#["http://localhost:8081/proyecto/Personas/ActualizarCorreo/" ++ vars.id]'>
			<http:body ><![CDATA[#[payload.correo]]]></http:body>
		</http:request>
    </flow>
    <flow name="get:\BuscarUsuarioPorId\(id):proyectointegrador-config">
        <ee:transform doc:name="Transform Message">
            <ee:variables>
                <ee:set-variable variableName="id">attributes.uriParams.'id'</ee:set-variable>
            </ee:variables>
        </ee:transform>
		<logger level="INFO" doc:name="Logger" doc:id="c8ac4272-0c78-4fb5-8dd2-c5b53f38d8e1" message='ID Recuperado #[vars.id]'/>
		<http:request method="GET" doc:name="Request Get Usuario" doc:id="36865bb9-e41a-4d28-9e84-867a923964c0" url='#["http://localhost:8081/proyecto/Personas/BuscarUsuarioPorId/"++ vars.id]'/>
		<logger level="INFO" doc:name="Logger" doc:id="3ed136c7-fa7b-4858-a2a5-0a2ddd9bae4a" message="Usuario recibido #[payload]"/>
    </flow>
    <flow name="get:\users:proyectointegrador-config">
        <logger level="INFO" message="get:\users:proyectointegrador-config" />
		<http:request method="GET" doc:name="Request" doc:id="f45ce356-3030-4072-b2ff-09e843db961e" url="https://jsonplaceholder.typicode.com/users"/>
		<ee:transform doc:name="Transform Message" doc:id="7956c498-ea58-4e03-8e4e-01bd692410c3" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
(payload filter ((item) -> item.id<6 )) map ((item) -> {
    "name":item.name,
    "email": item.email,
    "city": item.address.city,
    "company name": item.company.name
})]]></ee:set-payload>
			</ee:message>
		</ee:transform>
    </flow>
    <flow name="post:\InsertarUsuario:application\json:proyectointegrador-config">
        <logger level="INFO" message="Objeto Persona recibido: #[payload]" />
		<ee:transform doc:name="Transform Message" doc:id="66a34dc8-c48a-46c8-bc90-5b248e040a3f" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
    "id": payload.id as Number,
    "genero": payload.genero,
    "nombre":payload.nombre,
    "apellido":payload.apellido,
    "ciudad":payload.ciudad,
    "pais":payload.pais,
    "coordenadas": {
        "latitud":payload.coordenadas.latitud as Number,
        "longitud": payload.coordenadas.longitud as Number
    },
    "login":payload.login,
    "email":payload.email,
    "fechaNacimiento":payload.fechaNacimiento,
    "celular":payload.celular
    
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<http:request method="POST" doc:name="Request" doc:id="64420efc-ba59-46c7-8d81-9e9cea734462" url='#["http://localhost:8081/proyecto/Personas/InsertarUsuario"]'/>
    </flow>
</mule>
